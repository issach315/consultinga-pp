    "@mui/x-data-grid": "^7.29.13",
    "@tanstack/react-query": "^5.62.7",
    "@tanstack/react-query-devtools": "^5.62.7",
    "axios": "^1.7.9",
    "formik": "^2.4.9",
    "libphonenumber-js": "^1.13.10",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-hook-form": "^7.54.2",
