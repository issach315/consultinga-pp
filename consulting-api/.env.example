APP_NAME=Consulting API
APP_ENV=development
DEBUG=true

# MySQL is expected to run on the host machine, not in Docker Compose.
# host.docker.internal lets the api container reach it; use "localhost"
# instead if you're running the api outside Docker too.
DATABASE_URL=mysql+pymysql://root:root@host.docker.internal:3306/consulting_db

JWT_SECRET_KEY=change-this-secret
JWT_ALGORITHM=HS256

ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

REDIS_URL=redis://redis:6379/0

MINIO_ENDPOINT=http://minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadminpassword
MINIO_BUCKET=consulting-files
MINIO_REGION=us-east-1
MINIO_SECURE=false

# Real SMTP provider required for invite emails to actually deliver — e.g.
# Gmail SMTP: host smtp.gmail.com, port 587, start_tls true, username your
# Gmail address, password a Google App Password (not your account password).
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=noreply@consulting.local
MAIL_FROM_NAME=Consulting SaaS
MAIL_USE_TLS=false
MAIL_START_TLS=true

CORS_ORIGINS=http://localhost:5173

INVITATION_EXPIRY_DAYS=7
# Fallback footer contact address for invitation emails, used when a tenant
# hasn't set its own branding.support_email.
SUPPORT_EMAIL=support@consulting.local
